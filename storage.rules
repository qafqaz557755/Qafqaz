rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /orders/{allPaths=**} {
      allow read: if true;
      allow write: if true; // In production, you'd restrict this, but for this context we need to allow uploads
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
